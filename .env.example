# Copy to .env and fill in. Never commit .env (it is in .gitignore).
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string

# Local MongoDB while developing:
# MONGO_URL=mongodb://localhost:27017/unque

# Amazon DocumentDB on EC2 (TLS required; retryWrites is off because DocumentDB does not support retryable writes):
# MONGO_URL=mongodb://USER:PASSWORD@YOUR-CLUSTER.cluster-xxxxxxxx.REGION.docdb.amazonaws.com:27017/unque?tls=true&tlsCAFile=global-bundle.pem&retryWrites=false
